{
  "name": "newsread",
  "version": "0.1.0",
  "private": true,
  "description": "Low-volume personal news scraper that emits Souspli `article` things",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "newsread": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "fast-xml-parser": "^5.11.1",
    "linkedom": "^0.18.13"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
